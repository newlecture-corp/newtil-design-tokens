{
	"name": "@newtil/design-tokens",
	"version": "0.2.4",
	"description": "Shared CSS design tokens (variables) for the newtil ecosystem — colors, spacing, sizes, shadows, typography",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "./dist/tokens.css",
	"style": "./dist/tokens.css",
	"exports": {
		".": "./dist/tokens.css",
		"./tokens.css": "./dist/tokens.css",
		"./index.css": "./css/index.css",
		"./primitive/*": "./css/primitive/*",
		"./semantic/*": "./css/semantic/*",
		"./package.json": "./package.json",
		"./deprecated.css": "./css/deprecated.css"
	},
	"keywords": [
		"css",
		"design tokens",
		"css variables",
		"design system"
	],
	"author": "lectureteam",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/newlecture-corp/newtil-design-tokens.git"
	},
	"bugs": {
		"url": "https://github.com/newlecture-corp/newtil-design-tokens/issues"
	},
	"homepage": "https://github.com/newlecture-corp/newtil-design-tokens#readme",
	"scripts": {
		"build": "node scripts/build.mjs",
		"check": "node scripts/check.mjs",
		"test": "npm run check",
		"prepublishOnly": "npm run build && npm run check",
		"docs:tokens": "node scripts/docs-tokens.mjs",
		"docs:dev": "npm run docs:tokens && vitepress dev docs --host",
		"docs:build": "npm run docs:tokens && vitepress build docs",
		"docs:preview": "vitepress preview docs"
	},
	"files": [
		"css",
		"dist",
		"README.md",
		"LICENSE"
	],
	"devDependencies": {
		"vitepress": "^1.6.4"
	}
}
